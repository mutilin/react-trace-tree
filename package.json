{
  "name": "react-trace-tree-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "build": "npm run build -w @mutilin/trace-tree-core && npm run build -w @mutilin/react-trace-tree",
    "test": "mocha -r ts-node/register packages/core/src/**/*.spec.ts packages/react/src/**/*.spec.tsx demo/src/**/*.spec.ts",
    "demo": "npm run dev -w trace-tree-demo",
    "demo:build": "npm run build -w trace-tree-demo"
  },
  "devDependencies": {
    "@types/mocha": "7.0.2",
    "@types/node": "14.18.63",
    "@types/react": "16.9.26",
    "@types/react-dom": "16.9.5",
    "mocha": "10.8.2",
    "react": "16.13.1",
    "react-dom": "16.13.1",
    "react-test-renderer": "^16.13.1",
    "ts-node": "8.8.2",
    "typescript": "3.8.3",
    "vite": "4.5.14"
  }
}
